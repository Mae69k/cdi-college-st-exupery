# Base de donnees Postgres (Vercel Postgres / Neon).
# En local : deux options.
#   - "npm run db"  -> Postgres embarque, port 55433 : postgres://postgres@127.0.0.1:55433/cdi
#   - docker compose up -d db -> port 5432 : postgres://postgres:postgres@localhost:5432/cdi
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cdi

# Secret de signature des cookies de session (generer une valeur aleatoire longue).
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Stockage des fichiers (Vercel Blob). Fourni automatiquement par l'integration Vercel Blob.
# En local, cree un store Blob sur Vercel et colle le token ici pour tester les uploads.
BLOB_READ_WRITE_TOKEN=

# Facultatif
NODE_ENV=development
